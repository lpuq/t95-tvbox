+/*
+ * Translate a logical segment pattern (bit 0 = a ... bit 6 = g, bit 7 = dp)
+ * into the bits the panel is actually wired to (DT "segment-map").
+ */
+static unsigned char
+fd6551_map_segments(struct fd6551_priv *priv, unsigned char logical)
+{
+	unsigned char physical = 0;
+	int seg;
+
+	for (seg = 0; seg < 8; seg++)
+		if (logical & BIT(seg))
+			physical |= BIT(priv->segment_map[seg]);
+
+	return physical;
+}
