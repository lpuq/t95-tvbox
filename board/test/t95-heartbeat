#!/bin/sh
# Stability-test heartbeat: one status line per minute to the serial console
# (captured on the PC by screen -L) and the journal. If the box freezes, the
# last line on serial shows when; if only the network dies, the lines keep
# coming with carrier=0. Each line is also appended to HBLOG and synced to
# disk at once, so a freeze loses at most the current minute.
HBLOG=/var/log/t95-stress/heartbeat.log
mkdir -p "${HBLOG%/*}"
zone() { for z in /sys/class/thermal/thermal_zone*; do
	[ "$(cat $z/type)" = "$1" ] && { awk '{printf "%.1f", $1/1000}' $z/temp; return; }; done; }
while :; do
	l="hb $(date -u +%FT%TZ) up=$(cut -d. -f1 /proc/uptime) load=$(cut -d' ' -f1 /proc/loadavg)"
	l="$l cpu=$(zone cpu-thermal)C ddr=$(zone ddr-thermal)C"
	l="$l f=$(($(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq)/1000))/$(($(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq)/1000))MHz"
	l="$l avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)M"
	# look the NIC up every time: at boot the USB adapter appears after us
	NIC=$(ls -d /sys/class/net/enx* 2>/dev/null | head -1)
	[ -n "$NIC" ] && l="$l carrier=$(cat $NIC/carrier 2>/dev/null || echo gone)"
	echo "$l"
	echo "$l" > /dev/ttyS0
	echo "$l" >> "$HBLOG" && sync "$HBLOG"
	sleep 60
done
