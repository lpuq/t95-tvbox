CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h616-t95"
CONFIG_SPL=y
CONFIG_MACH_SUN50I_H616=y
# DRAM: DDR3 values read from the vendor boot0 dram_para (eMMC @ 8 KiB)
CONFIG_SUNXI_DRAM_H616_DDR3_1333=y
CONFIG_DRAM_CLK=600
CONFIG_DRAM_SUNXI_DX_ODT=0x03030303
CONFIG_DRAM_SUNXI_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUNXI_CA_DRI=0x1c12
CONFIG_DRAM_SUNXI_TPR0=0xc0000a05
CONFIG_DRAM_SUNXI_TPR6=0x33808080
CONFIG_DRAM_SUNXI_TPR10=0x2f0006
CONFIG_DRAM_SUNXI_TPR11=0xddddcccc
CONFIG_DRAM_SUNXI_TPR12=0xeddc7564
# Secure-boot SoC with empty ROTPK fuse: boot ROM needs a (self-)signed TOC0
CONFIG_SPL_IMAGE_TYPE_SUNXI_TOC0=y
CONFIG_MMC_SUNXI_SLOT_EXTRA=2
CONFIG_R_I2C_ENABLE=y
# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
CONFIG_SPL_I2C=y
CONFIG_SPL_SYS_I2C_LEGACY=y
CONFIG_SYS_I2C_MVTWSI=y
CONFIG_SYS_I2C_SLAVE=0x7f
CONFIG_SYS_I2C_SPEED=400000
CONFIG_SUPPORT_EMMC_BOOT=y
# PMIC: AXP1530 (passes the AXP313 chip-id check); DCDC3 = DDR3 1.5 V
CONFIG_AXP313_POWER=y
CONFIG_AXP_DCDC3_VOLT=1500
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
# UART RX is not wired on this board (input never reaches U-Boot), so
# diagnostics run automatically. RAM alias test: if 0x50000000 reads back
# 22222222, the region 2 GiB higher is the same chip -> only 2 GiB fitted.
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="echo === T95 RAM alias test ===; mw.l 0x50000000 0x11111111; mw.l 0xd0000000 0x22222222; md.l 0x50000000 1; md.l 0xd0000000 1; echo === end RAM test ==="
